{
  "name": "pipsocket",
  "version": "0.1.0-alpha.1",
  "description": "TypeScript client for the Pipsocket API: REST and WebSocket access to MetaTrader 5 accounts hosted by Pipsocket.",
  "keywords": [
    "pipsocket",
    "trading",
    "trading-api",
    "forex",
    "algotrading",
    "websocket",
    "typescript"
  ],
  "homepage": "https://pipsocket.com",
  "bugs": {
    "url": "https://github.com/pipsocket/pipsocket-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipsocket/pipsocket-node.git"
  },
  "license": "MIT",
  "author": "Pipsocket <support@pipsocket.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "ws": "^8.17.1"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm generate:check && pnpm test",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "ws": "8.18.3"
  },
  "packageManager": "pnpm@10.20.0"
}
